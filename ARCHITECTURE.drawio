        <mxCell id="anthropic" value="Anthropic API&#10;[anthropic] extra&#10;— optional, cloud —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="640" y="440" width="180" height="60" as="geometry" />
