{
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "**/__pycache__",
        "build",
        "dist"
    ],
    "extraPaths": [
        "src"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.10",
    "reportIncompatibleMethodOverride": "error",
    "typeCheckingMode": "basic"
}
